# What the Magic Initiate pools are spent on: one object per spell
# the named list holds, carrying the SPELLS: that puts it on the
# sheet, and one per ability score the feat may cast from.

CATEGORY=Internal|Default.MOD	DEFINE:POOL_Magic_Initiate_Cleric_Cantrip|0	DEFINE:POOL_Magic_Initiate_Cleric_Spell|0	DEFINE:POOL_Magic_Initiate_Spellcasting_Ability|0	DEFINE:POOL_Magic_Initiate_Druid_Cantrip|0	DEFINE:POOL_Magic_Initiate_Druid_Spell|0	DEFINE:POOL_Magic_Initiate_Wizard_Cantrip|0	DEFINE:POOL_Magic_Initiate_Wizard_Spell|0

