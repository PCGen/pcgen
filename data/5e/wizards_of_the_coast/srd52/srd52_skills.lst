# The eighteen skills, read from the Skills table in "Playing the Game".
#
# VISIBLE:EXPORT rather than YES: in the 2024 rules a skill is not a thing a
# character buys ranks in, it is a proficiency granted by a class, background
# or species, so the skill list is somewhere to look things up rather than
# somewhere to spend points.

Acrobatics	KEYSTAT:DEX	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Animal Handling	KEYSTAT:WIS	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Arcana	KEYSTAT:INT	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Athletics	KEYSTAT:STR	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Deception	KEYSTAT:CHA	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
History	KEYSTAT:INT	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Insight	KEYSTAT:WIS	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Intimidation	KEYSTAT:CHA	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Investigation	KEYSTAT:INT	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Medicine	KEYSTAT:WIS	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Nature	KEYSTAT:INT	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Perception	KEYSTAT:WIS	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Performance	KEYSTAT:CHA	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Persuasion	KEYSTAT:CHA	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Religion	KEYSTAT:INT	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Sleight of Hand	KEYSTAT:DEX	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Stealth	KEYSTAT:DEX	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
Survival	KEYSTAT:WIS	VISIBLE:EXPORT	SOURCEPAGE:SRD 5.2.1, p.9
