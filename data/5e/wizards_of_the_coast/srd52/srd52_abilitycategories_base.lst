# The categories every other file sorts its abilities into. These load
# first: a CATEGORY: naming one that does not exist yet is not an error
# PCGen reports against the category, it is the ability being discarded.

ABILITYCATEGORY:Special Ability	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Special Ability
ABILITYCATEGORY:Internal	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Internal
ABILITYCATEGORY:Skill	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Skill
ABILITYCATEGORY:Language	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Language
ABILITYCATEGORY:Spell	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Spell
ABILITYCATEGORY:Weapon	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Weapon
ABILITYCATEGORY:Class	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Class
ABILITYCATEGORY:SkillExport	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:SkillExport
ABILITYCATEGORY:Language Selection	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_Language_Selection	CATEGORY:Language	TYPE:Language	PLURAL:Languages	DISPLAYLOCATION:Character
ABILITYCATEGORY:Expertise	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Expertise	CATEGORY:Special Ability	TYPE:Expertise	PLURAL:Expertise	DISPLAYLOCATION:Character
ABILITYCATEGORY:Skill Proficiency	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	CATEGORY:Skill	TYPE:Skill Proficiency	PLURAL:Skill Proficiencies	DISPLAYLOCATION:Character
