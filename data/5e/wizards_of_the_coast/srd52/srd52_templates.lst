# The Core Traits box of the class a character took first.
#
# A second class grants less than a first one does, and a CLASS line cannot
# say so: it fires whenever the class is taken. PCGen's answer is a template
# chosen once from those the character qualifies for, which is a stored
# choice rather than a condition re-evaluated at every level. The chooser
# that applies one of these lives in the foundation file; the smaller
# multiclass set is an ability in the class abilities file.

First Level	TEMPLATE:CHOOSE:TYPE=FirstLevel

Barbarian First Level	PRECLASS:1,Barbarian=1	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Strength	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Constitution	AUTO:WEAPONPROF|TYPE.Simple|TYPE.Martial	BONUS:WEAPONPROF=TYPE.Simple|TOHIT|Proficiency_Bonus|TYPE=Class	BONUS:WEAPONPROF=TYPE.Martial|TOHIT|Proficiency_Bonus|TYPE=Class	AUTO:ARMORPROF|ARMORTYPE=LightArmor|ARMORTYPE=MediumArmor	AUTO:SHIELDPROF|Shield	ADD:ABILITY|2|Skill|NORMAL|Animal Handling,Athletics,Intimidation,Nature,Perception,Survival	TYPE:FirstLevel
Bard First Level	PRECLASS:1,Bard=1	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Dexterity	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Charisma	AUTO:WEAPONPROF|TYPE.Simple	BONUS:WEAPONPROF=TYPE.Simple|TOHIT|Proficiency_Bonus|TYPE=Class	AUTO:ARMORPROF|ARMORTYPE=LightArmor	ADD:ABILITY|3|Skill|NORMAL|TYPE=Skill Proficiency	TYPE:FirstLevel
Cleric First Level	PRECLASS:1,Cleric=1	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Wisdom	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Charisma	AUTO:WEAPONPROF|TYPE.Simple	BONUS:WEAPONPROF=TYPE.Simple|TOHIT|Proficiency_Bonus|TYPE=Class	AUTO:ARMORPROF|ARMORTYPE=LightArmor|ARMORTYPE=MediumArmor	AUTO:SHIELDPROF|Shield	ADD:ABILITY|2|Skill|NORMAL|History,Insight,Medicine,Persuasion,Religion	TYPE:FirstLevel
Druid First Level	PRECLASS:1,Druid=1	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Intelligence	ABILITY:Internal|AUTOMATIC|Saving Throw ~ Wisdom	AUTO:WEAPONPROF|TYPE.Simple	BONUS:WEAPONPROF=TYPE.Simple|TOHIT|Proficiency_Bonus|TYPE=Class	AUTO:ARMORPROF|ARMORTYPE=LightArmor	AUTO:SHIELDPROF|Shield	ADD:ABILITY|2|Skill|NORMAL|Animal Handling,Arcana,Insight,Medicine,Nature,Perception,Religion,Survival	TYPE:FirstLevel
