<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>

<fx:root type="DialogPane" xmlns:fx="http://javafx.com/fxml/1" prefWidth="760" prefHeight="560">
    <fx:define>
        <ToggleGroup fx:id="locations"/>
    </fx:define>
    <content>
        <VBox spacing="12">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="%in_diDataSet" labelFor="$archivePath"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="archivePath" editable="false" HBox.hgrow="ALWAYS"/>
                <Button fx:id="choose" text="%in_select" onAction="#onChoose">
                    <tooltip><Tooltip text="%in_diChooserTitle"/></tooltip>
                </Button>
            </HBox>
            <Label text="%in_diLocation"/>
            <HBox spacing="18">
                <RadioButton fx:id="dataLocation" text="%in_diData" toggleGroup="$locations">
                    <tooltip><Tooltip text="%in_diData_tip"/></tooltip>
                </RadioButton>
                <RadioButton fx:id="vendorLocation" text="%in_diVendorData" toggleGroup="$locations">
                    <tooltip><Tooltip text="%in_diVendorData_tip"/></tooltip>
                </RadioButton>
                <RadioButton fx:id="homebrewLocation" text="%in_diHomebrewData" toggleGroup="$locations">
                    <tooltip><Tooltip text="%in_diHomebrewData_tip"/></tooltip>
                </RadioButton>
            </HBox>
            <WebView fx:id="information" prefHeight="320" VBox.vgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="progress" prefWidth="180"/>
                <Label fx:id="status" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="install" text="%in_diInstall" onAction="#onInstall">
                    <tooltip><Tooltip text="%in_diInstallTip"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </content>
</fx:root>
